# VWorld 배경지도 인증키 (https://www.vworld.kr 에서 발급)
VWORLD_ACCESS_KEY=YOUR_VWORLD_ACCESS_KEY

# MapPrime(지도 서버) 베이스 URL — 예: http://host:8080/geoserver
# WMS/WFS/WMTS 엔드포인트가 이 URL 하위(/wms, /wfs, /gwc/service/wmts)에 있다고 가정한다.
MAPPRIME_BASE_URL=http://localhost:8080/geoserver

# (선택) 워크스페이스 — 레이어명 앞에 붙일 접두어. 없으면 비워 둔다. (예: education)
MAPPRIME_WORKSPACE=
